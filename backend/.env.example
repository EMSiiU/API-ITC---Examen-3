# Use only in local development. Never commit real values.
NODE_ENV=development
PORT=3000
FRONTEND_ORIGIN=http://localhost:5173
SESSION_COOKIE_NAME=pta_session
SESSION_TTL_HOURS=8
# Local development: false. Production: true.
COOKIE_SECURE=false
# `none` requires COOKIE_SECURE=true and is only for cross-site deployments.
COOKIE_SAME_SITE=lax
